# Application Environment: development | production
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS
# In production on Render, set this to your deployed Vercel domain (e.g. https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exchange rate upstream request timeout (seconds)
API_TIMEOUT_SECONDS=15.0

# In-memory exchange rate cache TTL fallback (seconds)
CACHE_TTL_SECONDS=3600

# Optional Google Gemini API Key (for future conversational AI features)
# Ordinary currency conversion does NOT require this key.
GEMINI_API_KEY=your_gemini_api_key_here
